{
  "$comment": "Default Ruth config. The local model is named Ruth (Ollama `ruth` on uncensored Qwen3.5 2B, with vision).",
  "model": "ollama/ruth",
  "small_model": "ollama/ruth",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/ruth/**",
      "effect": "allow"
    }
  ],
  "plugins": [],
  "provider": {
    "ollama": {
      "package": "@ruth/ai/providers/openai-compatible",
      "options": {
        "headerTimeout": 1200000,
        "reasoningEffort": "none"
      },
      "models": {
        "ruth": {
          "tool_call": true,
          "reasoningEffort": "none"
        }
      }
    }
  },
  "update": "disable"
}
