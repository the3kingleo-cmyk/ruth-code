{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "ruth": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.ruth.desktop/Ruth.exe",
        "macos": "/Applications/Ruth.app/Contents/MacOS/Ruth"
      },
      "unset": ["RUTH_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "RUTH_DB": "{home}/.local/share/ruth/ruth.db",
        "RUTH_CONFIG_DIR": "{home}/.config/ruth",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/ruth"],
      "files": {
        ".config/ruth/service.json": { "port": "{port}" },
        "AppData/Local/@ruthdesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/ruth/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["ruth"]
    },
    "ruth-beta": {
      "extends": "ruth",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.ruth.desktop.beta/Ruth Beta.exe",
        "macos": "/Applications/Ruth Beta.app/Contents/MacOS/Ruth Beta"
      }
    }
  }
}
